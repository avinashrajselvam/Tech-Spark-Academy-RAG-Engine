# Server
PORT=3000

# Embeddings
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# AI Generation (Fast Model)
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=deepseek-coder:1.3b

# Vector Store
VECTOR_STORE_PATH=./data/vector_store.json
