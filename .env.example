# Server
PORT=3000

# Embeddings
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# AI Generation (optional — leave empty for template-based fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Vector Store
VECTOR_STORE_PATH=./data/vector_store.json
